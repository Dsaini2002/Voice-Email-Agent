{
  "manifest_version": 3,
  "name": "Vaani – Voice AI agent for Gmail",
  "short_name": "Vaani",
  "version": "0.2.0",
  "description": "JARVIS-style voice agent that works on top of Gmail: spoken briefings, filters, open folders and clean up spam by voice.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Vaani", "default_popup": "popup.html" },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:5173/*",
    "http://localhost:4000/*",
    "http://127.0.0.1:5173/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*", "http://localhost:4000/*", "http://127.0.0.1:5173/*"],
      "js": ["dist/connect.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*.woff2"], "matches": ["https://mail.google.com/*"] }
  ]
}
