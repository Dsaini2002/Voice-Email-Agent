# ---------- Server ----------
PORT=4000
# URL where the web dashboard runs (used for redirects + CORS)
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---------- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ----------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an "Authorized redirect URI" in the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ---------- Gemini (https://aistudio.google.com/apikey) ----------
GEMINI_API_KEY=your-gemini-api-key
# "gemini-flash-latest" always points to Google's newest Flash model
GEMINI_MODEL=gemini-flash-latest
# Minimum gap between Gemini calls (ms). Increase if you hit free-tier rate limits.
GEMINI_MIN_INTERVAL_MS=4000

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vaanimail

# ---------- Security ----------
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Any long random string. Generate the same way as above.
SESSION_SECRET=

# ---------- Sync ----------
# poll   = check Gmail for new mail every POLL_INTERVAL_SEC (works on localhost)
# pubsub = Gmail push notifications through Google Cloud Pub/Sub (needs a public HTTPS URL)
SYNC_MODE=poll
POLL_INTERVAL_SEC=60
# On first login, how many days of inbox to read, and the max number of emails
INITIAL_SYNC_DAYS=7
INITIAL_SYNC_MAX=150

# Only for SYNC_MODE=pubsub
# Format: projects/<project-id>/topics/<topic-name>
GMAIL_PUBSUB_TOPIC=
# Secret added to the push endpoint URL: https://your-domain/api/gmail/push?token=<this>
PUBSUB_VERIFICATION_TOKEN=
